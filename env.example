# Template for the compose environment file.
#   cp env.example .env
# Then edit .env. It is git-ignored; never commit real credentials.
#
# Every published port binds to 127.0.0.1, so the stack is reachable from this
# machine only. See the README for why that matters more than a host firewall.

# --- Published ports on the host -------------------------------------------------
WEB_PORT=8080
PMA_PORT=8081
FTP_PORT=21
FTP_PASSIVE_MIN=21000
FTP_PASSIVE_MAX=21010

# Only used if you uncomment the mysql ports mapping in docker-compose.yml.
MYSQL_PORT=3306

# --- Mailpit ---------------------------------------------------------------------
# Port the application connects to, published on the host on the same number.
# Changing it re-points the app, Mailpit and the host mapping together.
MAILPIT_SMTP_PORT=1125
# Host port for the Mailpit web UI (http://localhost:8025 inside the container).
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=500

# --- FTP -------------------------------------------------------------------------
FTP_USER=user
FTP_PASSWORD=change-me

# Address the FTP client is told to open its passive data connection to.
# These FTP ports are loopback-only, so 127.0.0.1 is the correct value.
FTP_PASV_ADDRESS=127.0.0.1

# Owner of the uploaded files: your uid, so you own what you upload (`id -u`).
FTP_UID=1000
# Group of the uploaded files, and the FTP account's primary group. It must be
# the group the web server runs as, or the application cannot write its cache and
# 0777 becomes the only workaround. www-data is gid 33 in the php:8.3-apache
# image: `docker compose exec web id www-data`.
WEB_GID=33

# --- MySQL -----------------------------------------------------------------------
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# Extra schemas to create besides MYSQL_DATABASE, space-separated (for example
# "app_one app_two"). Each one is granted to MYSQL_USER on the first start only.
EXTRA_DATABASES=

# --- Misc ------------------------------------------------------------------------
TZ=America/Argentina/Buenos_Aires
